# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mattermost — URL da instância ou de um canal específico
VITE_MATTERMOST_URL=https://chat.suaempresa.com

# Somente no servidor. Nunca use prefixo VITE_ para estas variáveis.
OPENAI_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Google Calendar — server only. OAuth Web client, never prefix these with VITE_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes encoded as 64 hex characters. Keep stable to decrypt refresh tokens.
GOOGLE_CALENDAR_ENCRYPTION_KEY=
